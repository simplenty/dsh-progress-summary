{
  "name": "dsh-progress-summary",
  "version": "0.1.0",
  "description": "Out-of-band progress narration for DeepSeek Harness: a cheap auxiliary model turns live reasoning into one short status line, for the Web UI and dsh-tui",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./narrator": "./narrator.js",
    "./projection": "./projection.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "narrator.js",
    "projection.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "progress",
    "narration",
    "status"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check narrator.js && node --check projection.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tastynoob/dsh-progress-summary.git"
  },
  "homepage": "https://github.com/tastynoob/dsh-progress-summary#readme",
  "bugs": {
    "url": "https://github.com/tastynoob/dsh-progress-summary/issues"
  }
}
